ALGORITMO EmitirNotaFiscalSaida()
DECLARE UF_DEST TEXTO
DECLARE I NUMÉRICO
DECLARE TOT_NOTA, TOT_IMP, VAL_I NUMÉRICO
INÍCIO
  |ESCREVA "UF DESTINO [Exemplo correto: SP]: "
  |LEIA UF_DEST
  |CONVERTER UF_DEST PARA MAIÚSCULAS
  |TOT_NOTA <- 0; TOT_IMP <- 0
  |PARA I <- 1 ATÉ TOTAL_PRODUTOS FAÇA
  |INÍCIO
  ||SE PRODUTO[I] <> "" ENTÃO
  ||INÍCIO
  |||VAL_I <- PRECO[I] * ESTOQUE[I]
  |||TOT_NOTA <- TOT_NOTA + VAL_I
  |||TOT_IMP <- TOT_IMP + CalcularImpostoItem(VAL_I, BuscarAliquotaICMS(NCM[I], UF_ORIGEM, UF_DEST, ANO_FISCAL))
  ||FIM
  |FIM
  |ESCREVA "--- NOTA FISCAL DE SAÍDA (EXERCÍCIO ", ANO_FISCAL, ") ---"
  |ESCREVA "VALOR BRUTO: R$ ", TOT_NOTA, " | TRIBUTOS ESTIMADOS: R$ ", TOT_IMP
FIM
FIM_ALGORITMO

ALGORITMO ExibirBalancoFinanceiro()
DECLARE LUCRO_BRUTO, LUCRO_OPERACIONAL, IMPOSTOS_SOBRE_LUCRO, LUCRO_LIQUIDO_FINAL NUMÉRICO
INÍCIO
  |LUCRO_BRUTO <- RECEITA_VENDAS - GASTOS_ESTOQUE
  |LUCRO_OPERACIONAL <- LUCRO_BRUTO - SALARIOS_PAGOS
  |IMPOSTOS_SOBRE_LUCRO <- 0.0
  |SE LUCRO_OPERACIONAL > 0 ENTÃO IMPOSTOS_SOBRE_LUCRO <- LUCRO_OPERACIONAL * 0.15
  |LUCRO_LIQUIDO_FINAL <- LUCRO_OPERACIONAL - IMPOSTOS_SOBRE_LUCRO

  |ESCREVA "=================================================="
  |ESCREVA "      BALANÇO FINANCEIRO E DEMONSTRATIVO DRE      "
  |ESCREVA "=================================================="
  |ESCREVA " (★) SALDO ATUAL EM CAIXA DA LOJA: R$ ", SALDO_CAIXA
  |ESCREVA " (+) Receita Bruta de Vendas: R$ ", RECEITA_VENDAS
  |ESCREVA " (-) Custos de Abastecimento/Estoque: R$ ", GASTOS_ESTOQUE
  |ESCREVA "--------------------------------------------------"
  |ESCREVA " (=) LUCRO BRUTO DA LOJA: R$ ", LUCRO_BRUTO
  |ESCREVA " (-) Custos de Folha de Pagamento: R$ ", SALARIOS_PAGOS
  |ESCREVA "--------------------------------------------------"
  |ESCREVA " (=) Lucro Operacional Antes dos Impostos: R$ ", LUCRO_OPERACIONAL
  |ESCREVA " (-) Impostos sobre o Lucro (IRPJ/CSLL ~15%): R$ ", IMPOSTOS_SOBRE_LUCRO
  |ESCREVA "--------------------------------------------------"
  |ESCREVA " (★) LUCRO LÍQUIDO FINAL DA LOJA: R$ ", LUCRO_LIQUIDO_FINAL
  |ESCREVA "=================================================="
FIM
FIM_ALGORITMO

