  |ESCREVA "--- CADASTRO DE NOVO FUNCIONÁRIO ---"
  |ESCREVA "INFORME O ID FUNCIONAL EXCLUSIVO [Exemplo correto: F04]: "
  |LEIA NOVO_ID
  |NOVO_NOME <- LerNomeValido("NOME [Exemplo correto: CARLOS SOUZA]: ")
  |NOVO_CPF <- LerCPFValido()
  |ESCREVA "CARGO [1 - GERENTE | 2 - OPERADOR | 3 - FINANCEIRO] [Exemplo correto: 2]: "
  |LEIA C_OPT
