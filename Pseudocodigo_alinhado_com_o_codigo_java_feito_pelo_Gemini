DECLARE NOME_NOVO_PROD TEXTO
DECLARE NOME_DUPLICADO LÓGICO
INÍCIO
  |SE TOTAL_PRODUTOS >= 20 ENTÃO
  |INÍCIO
  ||ESCREVA ">>> ERRO: Limite máximo de produtos atingido (20)! <<<"
