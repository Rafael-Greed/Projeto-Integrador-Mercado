  ||NOME_DUPLICADO <- FALSO
  ||PARA P <- 1 ATÉ TOTAL_PRODUTOS FAÇA
  |||SE PRODUTO[P] <> "" E PRODUTO[P] = NOME_NOVO_PROD ENTÃO NOME_DUPLICADO <- VERDADEIRO
  ||SE NOME_DUPLICADO = VERDADEIRO ENTÃO
  |||ESCREVA ">>> ERRO: O nome do produto '", NOME_NOVO_PROD, "' já existe no sistema! <<<"
  ||SENÃO
  ||INÍCIO
  |||PRODUTO[ID_DESEJADO] <- NOME_NOVO_PROD
