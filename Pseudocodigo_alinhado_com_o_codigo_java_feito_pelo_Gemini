ALGORITMO AjustarPrecoEDesconto()
DECLARE I, ID_PR, TIPO_ALT NUMÉRICO
DECLARE NOVO_PRECO, DESC NUMÉRICO
INÍCIO
  |SE TOTAL_PRODUTOS > 0 ENTÃO
  |INÍCIO
  ||ESCREVA "--- AJUSTE DE PREÇOS E DESCONTOS ---"
  ||PARA I <- 1 ATÉ TOTAL_PRODUTOS FAÇA
  |||SE PRODUTO[I] <> "" ENTÃO ESCREVA "ID: ", I, " | ", PRODUTO[I], " | Preço Atual: R$ ", PRECO[I]
  ||ESCREVA "DIGITE O ID DO PRODUTO [Exemplo correto: 1]: "
  ||LEIA ID_PR
  ||SE ID_PR >= 1 E ID_PR <= TOTAL_PRODUTOS E PRODUTO[ID_PR] <> "" ENTÃO
  ||INÍCIO
  |||ESCREVA "ESCOLHA O TIPO DE ALTERAÇÃO:"
  |||ESCREVA "1 - Definir novo preço de venda fixo"
  |||ESCREVA "2 - Aplicar porcentagem de desconto (%)"
  |||LEIA TIPO_ALT
  |||SE TIPO_ALT = 1 ENTÃO
  |||INÍCIO
  ||||ESCREVA "DIGITE O NOVO PREÇO DE VENDA (R$): "
  ||||LEIA NOVO_PRECO
  ||||SE NOVO_PRECO >= 0 ENTÃO
  |||||PRECO[ID_PR] <- NOVO_PRECO
  |||||ESCREVA ">>> PREÇO ATUALIZADO COM SUCESSO! <<<"
  ||||SENÃO ESCREVA ">>> ERRO: O preço não pode ser negativo! <<<"
  |||FIM
  |||SENÃO SE TIPO_ALT = 2 ENTÃO
  |||INÍCIO
  ||||ESCREVA "DIGITE A PORCENTAGEM DE DESCONTO (%): "
  ||||LEIA DESC
  ||||SE DESC >= 0 E DESC <= 100 ENTÃO
  |||||PRECO[ID_PR] <- PRECO[ID_PR] - (PRECO[ID_PR] * (DESC / 100.0))
  |||||ESCREVA ">>> DESCONTO APLICADO COM SUCESSO! <<<"
  ||||SENÃO ESCREVA ">>> ERRO: Porcentagem inválida! <<<"
  |||FIM
  |||SENÃO ESCREVA ">>> ERRO: Opção inválida! <<<"
  ||FIM
  ||SENÃO ESCREVA ">>> ERRO: ID de produto inexistente! <<<"
  |FIM
  |SENÃO ESCREVA ">>> NENHUM PRODUTO CADASTRADO NO SISTEMA! <<<"
FIM
FIM_ALGORITMO

ALGORITMO MovimentarEstoque()
DECLARE I, POS_ITEM, QTDE_MOVER NUMÉRICO
DECLARE CUSTO_ABASTECIMENTO NUMÉRICO
INÍCIO
  |SE TOTAL_PRODUTOS > 0 ENTÃO
  |INÍCIO
  ||ESCREVA "--- MOVIMENTAÇÃO DE ESTOQUE E CUSTOS OPERACIONAIS ---"
  ||PARA I <- 1 ATÉ TOTAL_PRODUTOS FAÇA
  |||SE PRODUTO[I] <> "" ENTÃO ESCREVA "ID: ", I, " | ", PRODUTO[I], " | Estoque: ", ESTOQUE[I]
  ||ESCREVA "ID DO PRODUTO [Exemplo correto: 1]: "
  ||LEIA POS_ITEM
  ||SE POS_ITEM >= 1 E POS_ITEM <= TOTAL_PRODUTOS E PRODUTO[POS_ITEM] <> "" ENTÃO
  ||INÍCIO
  |||ESCREVA "QUANTIDADE ENTRADA [Exemplo correto: 30]: "
  |||LEIA QTDE_MOVER
  |||ESCREVA "CUSTO TOTAL DE ABASTECIMENTO (R$) [Exemplo correto: 1500.00]: "
