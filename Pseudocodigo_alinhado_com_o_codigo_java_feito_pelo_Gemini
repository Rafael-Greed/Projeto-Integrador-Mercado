  |||PRECO_ORIGINAL[ID_DESEJADO] <- PRECO[ID_DESEJADO]
  |||ESCREVA "ESTOQUE INICIAL [Exemplo correto: 50]: "
  |||LEIA ESTOQUE[ID_DESEJADO]
  |||ESCREVA "NCM [Exemplo correto: 2106.90.30]: "
  |||LEIA NCM[ID_DESEJADO]
  |||CEST[ID_DESEJADO] <- "NULO"; CFOP[ID_DESEJADO] <- "5102"; CST[ID_DESEJADO] <- "00"; CATEGORIA[ID_DESEJADO] <- 0
  |||SE ID_DESEJADO > TOTAL_PRODUTOS ENTÃO TOTAL_PRODUTOS <- ID_DESEJADO
  |||ESCREVA ">>> PRODUTO CADASTRADO NO ID ", ID_DESEJADO, "! <<<"
  ||FIM
  |FIM
  |SENÃO ESCREVA ">>> ERRO: ID inválido! O valor deve estar entre 1 e 20. <<<"
