ALGORITMO GerenciarFolhaSalarial()
DECLARE F NUMÉRICO
DECLARE FOLHA_PENDENTE_TOTAL NUMÉRICO
DECLARE STATUS_PAGTO, ALERTA_MEDIA, CONF_PAGTO TEXTO
INÍCIO
  |FOLHA_PENDENTE_TOTAL <- 0.0
  |ESCREVA "=================================================="
  |ESCREVA "   DEMONSTRATIVO DA FOLHA SALARIAL E MÉDIA FISCAL "
  |ESCREVA "=================================================="
  |PARA F <- 1 ATÉ TOTAL_FUNCIONARIOS FAÇA
  |INÍCIO
  ||SE NOME_FUNCIONARIO[F] <> "" ENTÃO
  ||INÍCIO
  |||STATUS_PAGTO <- "[PENDENTE]"
  |||SE PAGO[F] = VERDADEIRO ENTÃO STATUS_PAGTO <- "[JÁ PAGO]"
  |||ALERTA_MEDIA <- VerificarAlertaMediaSalarial(CARGO[F], SALARIO[F])
  |||ESCREVA "ID: ", ID_FUNCIONARIO[F], " | ", NOME_FUNCIONARIO[F], " (", CARGO[F], ") - R$ ", SALARIO[F], " ", STATUS_PAGTO, ALERTA_MEDIA
  |||SE PAGO[F] = FALSO ENTÃO FOLHA_PENDENTE_TOTAL <- FOLHA_PENDENTE_TOTAL + SALARIO[F]
  ||FIM
  |FIM
  |ESCREVA "--------------------------------------------------"
  |ESCREVA "VALOR TOTAL PENDENTE DE PAGAMENTO: R$ ", FOLHA_PENDENTE_TOTAL
  |SE FOLHA_PENDENTE_TOTAL = 0 ENTÃO
  ||ESCREVA ">>> TODOS OS FUNCIONÁRIOS JÁ FORAM PAGOS NESTE CICLO! <<<"
  |SENÃO
  |INÍCIO
  ||ESCREVA "DESEJA QUITAR OS SALÁRIOS PENDENTES? [S/N] [Exemplo correto: S]: "
  ||LEIA CONF_PAGTO
  ||SE CONF_PAGTO = "S" OU CONF_PAGTO = "s" ENTÃO
  ||INÍCIO
  |||SE SALDO_CAIXA >= FOLHA_PENDENTE_TOTAL ENTÃO
  |||INÍCIO
  ||||SALDO_CAIXA <- SALDO_CAIXA - FOLHA_PENDENTE_TOTAL
  ||||SALARIOS_PAGOS <- SALARIOS_PAGOS + FOLHA_PENDENTE_TOTAL
  ||||PARA F <- 1 ATÉ TOTAL_FUNCIONARIOS FAÇA
  |||||SE NOME_FUNCIONARIO[F] <> "" E PAGO[F] = FALSO ENTÃO PAGO[F] <- VERDADEIRO
  ||||ESCREVA ">>> FOLHA SALARIAL PENDENTE QUITADA COM SUCESSO! SALDO EM CAIXA ATUALIZADO. <<<"
  |||FIM
  |||SENÃO ESCREVA ">>> ERRO: Saldo em caixa insuficiente para pagar os salários pendentes! <<<"
  ||FIM
  |FIM
FIM
FIM_ALGORITMO

