ALGORITMO LerNomeValido(MENSAGEM)
DECLARE NOME TEXTO
INÍCIO
  |NOME <- ""
  |ENQUANTO VERDADEIRO FAÇA
  |INÍCIO
  ||ESCREVA MENSAGEM
  ||LEIA NOME
  ||SE NOME = "" ENTÃO
  |||ESCREVA ">>> ERRO: O campo não pode ficar vazio! Exemplo correto: MARIO SILVA. <<<"
  ||SENÃO SE NOME POSSUIR NÚMEROS ENTÃO
  |||ESCREVA ">>> ERRO: O nome não pode conter números! Exemplo correto: MARIO SILVA. <<<"
  ||SENÃO
  |||SAIR DO LAÇO
  ||FIM
  |FIM
  |RETORNE CONVERTER PARA MAIÚSCULAS(NOME)
FIM
FIM_ALGORITMO

ALGORITMO LerCPFValido()
DECLARE CPF TEXTO
DECLARE SOMA1, SOMA2, DV1, DV2, I, DIGITO NUMÉRICO
DECLARE CPF_VALIDO LÓGICO
INÍCIO
  |ENQUANTO VERDADEIRO FAÇA
  |INÍCIO
  ||ESCREVA "CPF (DIGITE APENAS OS 11 NÚMEROS) [Exemplo correto: 11144477735]: "
  ||LEIA CPF
  ||REMOVER TODOS OS CARACTERES NÃO NUMÉRICOS DE CPF
  ||SE COMPRIMENTO(CPF) <> 11 OU CPF FOR SEQUÊNCIA REPETIDA ("11111111111", etc.) ENTÃO
  |||ESCREVA ">>> ERRO: CPF INVÁLIDO! O CPF deve conter 11 dígitos reais. <<<"
  ||SENÃO
  |||// CÁLCULO DOS DÍGITOS VERIFICADORES (MÓDULO 11 RECEITA FEDERAL)
  |||SOMA1 <- 0
  |||SOMA2 <- 0
  |||PARA I <- 1 ATÉ 9 FAÇA
  |||INÍCIO
  ||||DIGITO <- OBTER DÍGITO NUMÉRICO DE CPF NA POSIÇÃO I
  ||||SOMA1 <- SOMA1 + (DIGITO * (10 - (I - 1)))
  ||||SOMA2 <- SOMA2 + (DIGITO * (11 - (I - 1)))
  |||FIM
  |||DV1 <- 11 - (SOMA1 MOD 11)
  |||SE DV1 > 9 ENTÃO DV1 <- 0
  |||SOMA2 <- SOMA2 + (DV1 * 2)
  |||DV2 <- 11 - (SOMA2 MOD 11)
  |||SE DV2 > 9 ENTÃO DV2 <- 0
  |||SE DV1 = DÍGITO NA POSIÇÃO 10 DE CPF E DV2 = DÍGITO NA POSIÇÃO 11 DE CPF ENTÃO
  ||||SAIR DO LAÇO
  |||SENÃO
  ||||ESCREVA ">>> ERRO: Os dígitos verificadores (DV) do CPF não conferem matematicamente! <<<"
  |||FIM
  ||FIM
  |FIM
  |RETORNE CPF
FIM
FIM_ALGORITMO

