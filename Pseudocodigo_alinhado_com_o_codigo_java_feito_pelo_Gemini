  |SENÃO SE C_OPT = 3 ENTÃO CARGO_DEFINIDO <- "FINANCEIRO"
  |TOTAL_FUNCIONARIOS <- TOTAL_FUNCIONARIOS + 1
  |ID_FUNCIONARIO[TOTAL_FUNCIONARIOS] <- NOVO_ID
  |NOME_FUNCIONARIO[TOTAL_FUNCIONARIOS] <- NOVO_NOME
  |CPF_FUNCIONARIO[TOTAL_FUNCIONARIOS] <- NOVO_CPF
  |CARGO[TOTAL_FUNCIONARIOS] <- CARGO_DEFINIDO
  |SENHA_FUNCIONARIO[TOTAL_FUNCIONARIOS] <- GerarSenhaAleatoriaSistema()
  |SALARIO[TOTAL_FUNCIONARIOS] <- ObterSalarioPadraoCargo(CARGO_DEFINIDO)
