ALGORITMO LerNomeValido()
DECLARE NOME TEXTO
INÍCIO
  |NOME <- ""
  |ENQUANTO NOME = "" OU NOME POSSUIR NÚMEROS FAÇA
  |INÍCIO
  ||ESCREVA "DIGITE O NOME COMPLETO. EXEMPLO: MARIO SILVA"
  ||LEIA NOME
  ||SE NOME = "" ENTÃO
  |||ESCREVA "ERRO: O CAMPO NÃO PODE FICAR VAZIO"
  ||SENÃO SE NOME POSSUIR NÚMEROS ENTÃO
  |||ESCREVA "ERRO: O NOME NÃO PODE CONTER NÚMEROS"
  ||FIM
  |NOME <- CONVERTER PARA MAIÚSCULAS(NOME)
  |RETORNE NOME
FIM
FIM_ALGORITMO

