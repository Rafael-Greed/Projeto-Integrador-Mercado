============================================================

ALGORITMO IdentificarCliente()
DECLARE SENHA_DIGITADA, SEXO, DATA_NASC, UF, CEP, SENHA_GERADA TEXTO
DECLARE CLIENTE_IDX, TENTATIVAS, I NUMÉRICO
DECLARE SENHA_CORRETA LÓGICO
INÍCIO
  |NOME_ATUAL <- LerNomeValido()
  |CPF_ATUAL <- LerCPFValido()
  |CLIENTE_IDX <- 0

  |PARA I <- 1 ATÉ TOTAL_CLIENTES FAÇA
  ||SE CPF_CLIENTE[I] = CPF_ATUAL ENTÃO
  |||CLIENTE_IDX <- I

  |SE CLIENTE_IDX > 0 ENTÃO
  |INÍCIO
  ||ESCREVA "CPF JÁ CADASTRADO (", NOME_CLIENTE[CLIENTE_IDX], ")"
  ||TENTATIVAS <- 3
  ||SENHA_CORRETA <- FALSO

  ||ENQUANTO TENTATIVAS > 0 E SENHA_CORRETA = FALSO FAÇA
  ||INÍCIO
  |||ESCREVA "DIGITE SUA SENHA: "
  |||LEIA SENHA_DIGITADA
  |||SE SENHA_DIGITADA = SENHA_CLIENTE[CLIENTE_IDX] ENTÃO
  ||||SENHA_CORRETA <- VERDADEIRO
  ||||NOME_ATUAL <- NOME_CLIENTE[CLIENTE_IDX]
  ||||CLIENTE_CADASTRADO <- VERDADEIRO
  ||||ESCREVA "SENHA CORRETA! Acesso liberado."
  |||SENÃO
  ||||TENTATIVAS <- TENTATIVAS - 1
  ||||SE TENTATIVAS > 0 ENTÃO
  |||||ESCREVA "SENHA INCORRETA. Restam ", TENTATIVAS
  ||||SENÃO
  |||||||ESCREVA "TENTATIVAS ESGOTADAS"
  ||||FIM
  |||FIM
  ||FIM

  ||SE SENHA_CORRETA = FALSO ENTÃO
  |||RETORNAR
  |FIM
  |SENÃO
  |INÍCIO
  ||ESCREVA "CPF não encontrado."
  ||ESCREVA "1 - Cadastrar agora   2 - Cadastrar só na finalização"
  ||LEIA OPCAO_NOVO

  ||SE OPCAO_NOVO = 1 ENTÃO
  ||INÍCIO
  |||ESCREVA "SEXO: "
  |||LEIA SEXO
  |||SE SEXO = "" ENTÃO SEXO <- "NÃO INFORMADO"
