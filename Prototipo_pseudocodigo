DECLARE FOLHA_PENDENTE NUMÉRICO
DECLARE CONFIRMACAO TEXTO
INÍCIO
  |FOLHA_PENDENTE <- 0
  |ESCREVA "=== FOLHA SALARIAL ==="

  |PARA I <- 1 ATÉ TOTAL_FUNCIONARIOS FAÇA
  |INÍCIO
  ||ESCREVA ID_FUNCIONARIO[I], " | ", NOME_FUNCIONARIO[I], " | R$ ", SALARIO[I]
  ||SE PAGO[I] = VERDADEIRO ENTÃO
  |||ESCREVA " [PAGO]"
  ||SENÃO
  |||ESCREVA " [PENDENTE]"
  |||FOLHA_PENDENTE <- FOLHA_PENDENTE + SALARIO[I]
  ||ESCREVA VerificarAlertaMediaSalarial(CARGO[I], SALARIO[I])
  |FIM

  |ESCREVA "TOTAL PENDENTE: R$ ", FOLHA_PENDENTE

  |SE FOLHA_PENDENTE = 0 ENTÃO
  ||ESCREVA "TODOS JÁ FORAM PAGOS"
  |SENÃO
  ||ESCREVA "QUITAR SALÁRIOS? [S/N]: "
