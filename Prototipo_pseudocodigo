ALGORITMO ExibirBalancoFinanceiro()
DECLARE LUCRO_BRUTO, LUCRO_OPERACIONAL, IMPOSTOS_LUCRO, LUCRO_LIQUIDO NUMÉRICO
INÍCIO
  |LUCRO_BRUTO <- RECEITA_VENDAS - GASTOS_ESTOQUE
  |LUCRO_OPERACIONAL <- LUCRO_BRUTO - SALARIOS_PAGOS
  |SE LUCRO_OPERACIONAL > 0 ENTÃO
  ||IMPOSTOS_LUCRO <- LUCRO_OPERACIONAL * 0.15
  |SENÃO
  ||IMPOSTOS_LUCRO <- 0
  |LUCRO_LIQUIDO <- LUCRO_OPERACIONAL - IMPOSTOS_LUCRO
  |ESCREVA "SALDO ATUAL EM CAIXA: R$ ", SALDO_CAIXA
  |ESCREVA "RECEITA BRUTA DE VENDAS: R$ ", RECEITA_VENDAS
  |ESCREVA "CUSTOS DE ABASTECIMENTO/ESTOQUE: R$ ", GASTOS_ESTOQUE
  |ESCREVA "LUCRO BRUTO DA LOJA: R$ ", LUCRO_BRUTO
  |ESCREVA "CUSTOS DA FOLHA DE PAGAMENTO: R$ ", SALARIOS_PAGOS
  |ESCREVA "LUCRO OPERACIONAL ANTES DOS IMPOSTOS: R$ ", LUCRO_OPERACIONAL
  |ESCREVA "IMPOSTOS SOBRE O LUCRO (15%): R$ ", IMPOSTOS_LUCRO
  |ESCREVA "LUCRO LÍQUIDO FINAL DA LOJA: R$ ", LUCRO_LIQUIDO
FIM
