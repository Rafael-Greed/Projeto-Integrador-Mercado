  |NOME_DUPLICADO <- FALSO
  |PARA I <- 1 ATÉ TOTAL_PRODUTOS FAÇA
  ||SE PRODUTO[I] = NOME ENTÃO
  |||NOME_DUPLICADO <- VERDADEIRO

  |SE NOME_DUPLICADO = VERDADEIRO ENTÃO
  ||ESCREVA "NOME JÁ EXISTE"
  |SENÃO
  ||ESCREVA "PREÇO DE VENDA: "
  ||LEIA PRECO_VENDA
  ||ESCREVA "ESTOQUE INICIAL: "
  ||LEIA ESTOQUE_INICIAL
  ||ESCREVA "NCM: "
  ||LEIA NCM
  ||PRODUTO[ID] <- NOME
  ||PRECO[ID] <- PRECO_VENDA
  ||PRECO_ORIGINAL[ID] <- PRECO_VENDA
  ||ESTOQUE[ID] <- ESTOQUE_INICIAL
  ||NCM[ID] <- NCM
  ||SE ID > TOTAL_PRODUTOS ENTÃO
  |||TOTAL_PRODUTOS <- ID
  ||ESCREVA "PRODUTO CADASTRADO"
FIM
