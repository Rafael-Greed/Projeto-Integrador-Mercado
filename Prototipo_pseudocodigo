ALGORITMO ListarFuncionarios()
DECLARE I NUMÉRICO
INÍCIO
  |ESCREVA "=================================================="
  |ESCREVA "        LISTA DE FUNCIONÁRIOS CADASTRADOS"
  |ESCREVA "=================================================="
  |PARA I <- 1 ATÉ TOTAL_FUNCIONARIOS FAÇA
  |INÍCIO
  ||ESCREVA "ID: ", ID_FUNCIONARIO[I]
  ||ESCREVA "NOME: ", NOME_FUNCIONARIO[I]
  ||ESCREVA "CARGO: ", CARGO[I]
  ||ESCREVA "CPF: ", CPF_FUNCIONARIO[I]
  ||ESCREVA "SALÁRIO: R$ ", SALARIO[I]
  ||SE PAGO[I] = VERDADEIRO ENTÃO
  |||ESCREVA "Status: Salário Pago"
  ||SENÃO
  |||ESCREVA "Status: Salário Pendente"
  ||ESCREVA VerificarAlertaMediaSalarial(CARGO[I], SALARIO[I])
  ||ESCREVA "--------------------------------------------------"
  |FIM
FIM
FIM_ALGORITMO

============================================================
MÓDULO 34 — ALTERAÇÃO DE SENHA DO FUNCIONÁRIO
============================================================

ALGORITMO AlterarSenhaFuncionario(FUNC_LOGADO)
DECLARE SENHA_ATUAL, NOVA_SENHA TEXTO
INÍCIO
  |ESCREVA "DIGITE SUA SENHA ATUAL: "
  |LEIA SENHA_ATUAL
  |SE SENHA_ATUAL = SENHA_FUNCIONARIO[FUNC_LOGADO] ENTÃO
  |INÍCIO
  ||ESCREVA "DIGITE A NOVA SENHA: "
  ||LEIA NOVA_SENHA
  ||SE NOVA_SENHA <> "" ENTÃO
  ||INÍCIO
  |||SENHA_FUNCIONARIO[FUNC_LOGADO] <- NOVA_SENHA
  |||ESCREVA "SENHA ALTERADA COM SUCESSO"
  ||FIM
  ||SENÃO
  |||ESCREVA "A NOVA SENHA NÃO PODE FICAR VAZIA"
  |FIM
  |SENÃO
  ||ESCREVA "SENHA ATUAL INCORRETA. ALTERAÇÃO CANCELADA"
FIM
FIM_ALGORITMO

