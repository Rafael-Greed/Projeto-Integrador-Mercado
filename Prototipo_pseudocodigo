DECLARE NOME, NCM TEXTO
DECLARE PRECO_VENDA NUMÉRICO
DECLARE NOME_DUPLICADO LÓGICO
INÍCIO
  |ESCREVA "ID DO PRODUTO (1 a 20): "
  |LEIA ID
  |SE ID < 1 OU ID > 20 ENTÃO
  ||ESCREVA "ID INVÁLIDO"
  ||RETORNE
