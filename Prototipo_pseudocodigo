  |INÍCIO
  ||SE PRODUTO[I] ESTIVER CADASTRADO ENTÃO
  ||INÍCIO
  |||VALOR_ITEM <- PRECO[I] * ESTOQUE[I]
  |||TOTAL_BRUTO <- TOTAL_BRUTO + VALOR_ITEM
  |||TOTAL_ICMS <- TOTAL_ICMS + CalcularImpostoItem(VALOR_ITEM, BuscarAliquotaICMS(NCM[I], "SP", UF_DESTINO, ANO_FISCAL))
