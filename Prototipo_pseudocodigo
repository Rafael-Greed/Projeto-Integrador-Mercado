ALGORITMO IdentificarCliente()
DECLARE SENHA_INFORMADA TEXTO
DECLARE OPCAO_CADASTRO, INDICE_CLIENTE, I, TENTATIVAS NUMÉRICO
DECLARE SENHA_CORRETA LÓGICO
INÍCIO
  |NOME_CLIENTE_ATUAL <- LerNomeValido()
  |CPF_CLIENTE_ATUAL <- LerCPFValido()
  |CLIENTE_IDENTIFICADO <- FALSO
  |CLIENTE_CADASTRADO <- FALSO
  |INDICE_CLIENTE <- 0
  |PARA I <- 1 ATÉ TOTAL_CLIENTES FAÇA
  ||SE CPF_CLIENTE[I] = CPF_CLIENTE_ATUAL ENTÃO
  |||INDICE_CLIENTE <- I
  |SE INDICE_CLIENTE > 0 ENTÃO
  |INÍCIO
  ||ESCREVA "CPF JÁ CADASTRADO: ", NOME_CLIENTE[INDICE_CLIENTE]
  ||TENTATIVAS <- 3
  ||SENHA_CORRETA <- FALSO
  ||ENQUANTO TENTATIVAS > 0 E SENHA_CORRETA = FALSO FAÇA
  ||INÍCIO
  |||ESCREVA "DIGITE SUA SENHA: "
  |||LEIA SENHA_INFORMADA
  |||SE SENHA_INFORMADA = SENHA_CLIENTE[INDICE_CLIENTE] ENTÃO
  ||||SENHA_CORRETA <- VERDADEIRO
  ||||CLIENTE_IDENTIFICADO <- VERDADEIRO
  ||||CLIENTE_CADASTRADO <- VERDADEIRO
  ||||NOME_CLIENTE_ATUAL <- NOME_CLIENTE[INDICE_CLIENTE]
  ||||SEXO_CLIENTE_ATUAL <- SEXO_CLIENTE[INDICE_CLIENTE]
  ||||DATA_NASCIMENTO_ATUAL <- DATA_NASCIMENTO[INDICE_CLIENTE]
  ||||UF_CLIENTE_ATUAL <- UF_CLIENTE[INDICE_CLIENTE]
  ||||CEP_CLIENTE_ATUAL <- CEP_CLIENTE[INDICE_CLIENTE]
  ||||ESCREVA "IDENTIFICAÇÃO CONCLUÍDA"
  |||SENÃO
  ||||TENTATIVAS <- TENTATIVAS - 1
  ||||ESCREVA "SENHA INCORRETA. TENTATIVAS RESTANTES: ", TENTATIVAS
  |||FIM
  ||FIM
  |SENÃO
  |INÍCIO
  ||ESCREVA "CPF NÃO ENCONTRADO"
  ||ESCREVA "1 - REALIZAR CADASTRO COMPLETO AGORA"
  ||ESCREVA "2 - CADASTRAR NA FINALIZAÇÃO DA COMPRA"
  ||LEIA OPCAO_CADASTRO
  ||SE OPCAO_CADASTRO = 1 ENTÃO
  ||INÍCIO
