============================================================
MÓDULO 13 — VALIDAÇÃO DE CPF (CORRIGIDO - MÓDULO 11 OFICIAL)
============================================================

ALGORITMO LerCPFValido()
DECLARE CPF TEXTO
DECLARE SOMA, RESTO, DV1, DV2, I, NUM NUMÉRICO
INÍCIO
  |ENQUANTO VERDADEIRO FAÇA
  |INÍCIO
  ||ESCREVA "CPF (11 NÚMEROS) [Exemplo: 11144477735]: "
  ||LEIA CPF
  ||REMOVER CARACTERES NÃO NUMÉRICOS DE CPF

  ||SE COMPRIMENTO(CPF) <> 11 OU CPF FOR SEQUÊNCIA REPETIDA ENTÃO
  |||ESCREVA "ERRO: CPF INVÁLIDO"
  |||CONTINUE
  ||FIM

  ||// Cálculo do 1º Dígito Verificador
  ||SOMA <- 0
  ||PARA I <- 1 ATÉ 9 FAÇA
  ||INÍCIO
  |||NUM <- VALOR DO DÍGITO I
  |||SOMA <- SOMA + NUM * (11 - I)
  ||FIM
  ||RESTO <- SOMA MOD 11
  ||SE RESTO < 2 ENTÃO
  |||DV1 <- 0
  ||SENÃO
  |||DV1 <- 11 - RESTO

  ||// Cálculo do 2º Dígito Verificador
  ||SOMA <- 0
  ||PARA I <- 1 ATÉ 9 FAÇA
  ||INÍCIO
  |||NUM <- VALOR DO DÍGITO I
  |||SOMA <- SOMA + NUM * (12 - I)
  ||FIM
  ||SOMA <- SOMA + DV1 * 2
  ||RESTO <- SOMA MOD 11
  ||SE RESTO < 2 ENTÃO
  |||DV2 <- 0
  ||SENÃO
  |||DV2 <- 11 - RESTO

  ||SE DV1 = DÍGITO 10 DE CPF E DV2 = DÍGITO 11 DE CPF ENTÃO
  |||INTERROMPA
  ||SENÃO
  |||ESCREVA "ERRO: Dígitos verificadores inválidos"
  ||FIM
  |FIM
  |RETORNE CPF
FIM
FIM_ALGORITMO

