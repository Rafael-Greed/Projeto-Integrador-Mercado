MÓDULO 28 — MOVIMENTAÇÃO DE ESTOQUE E CUSTOS
============================================================

ALGORITMO MovimentarEstoque()
DECLARE ID, QUANTIDADE NUMÉRICO
DECLARE CUSTO NUMÉRICO
INÍCIO
  |EXIBIR PRODUTOS E ESTOQUES
  |ESCREVA "DIGITE O ID DO PRODUTO"
  |LEIA ID
  |SE ID NÃO EXISTIR ENTÃO
  ||ESCREVA "ID DE PRODUTO INEXISTENTE"
  ||RETORNE
  |ESCREVA "QUANTIDADE DE ENTRADA"
  |LEIA QUANTIDADE
  |ESCREVA "CUSTO TOTAL DE ABASTECIMENTO"
  |LEIA CUSTO
  |SE QUANTIDADE <= 0 OU CUSTO < 0 ENTÃO
  ||ESCREVA "QUANTIDADE DEVE SER POSITIVA E CUSTO NÃO PODE SER NEGATIVO"
  ||RETORNE
  |SE SALDO_CAIXA >= CUSTO ENTÃO
  ||SALDO_CAIXA <- SALDO_CAIXA - CUSTO
  ||GASTOS_ESTOQUE <- GASTOS_ESTOQUE + CUSTO
  ||ESTOQUE[ID] <- ESTOQUE[ID] + QUANTIDADE
  ||ESCREVA "ESTOQUE ATUALIZADO E CUSTO DESCONTADO DO CAIXA"
  |SENÃO
  ||ESCREVA "SALDO EM CAIXA INSUFICIENTE"
FIM
FIM_ALGORITMO

============================================================
MÓDULO 29 — FOLHA SALARIAL
============================================================

ALGORITMO GerenciarFolhaSalarial()
DECLARE I NUMÉRICO
DECLARE FOLHA_PENDENTE NUMÉRICO
DECLARE CONFIRMACAO TEXTO
INÍCIO
  |FOLHA_PENDENTE <- 0
  |PARA I <- 1 ATÉ TOTAL_FUNCIONARIOS FAÇA
  |INÍCIO
  ||SE FUNCIONARIO[I] ESTIVER CADASTRADO ENTÃO
  ||INÍCIO
  |||ESCREVA "ID: ", ID_FUNCIONARIO[I], " | NOME: ", NOME_FUNCIONARIO[I], " | CARGO: ", CARGO[I], " | SALÁRIO: R$ ", SALARIO[I], " | PAGO: ", PAGO[I]
  |||EXIBIR VerificarAlertaMediaSalarial(CARGO[I], SALARIO[I])
  |||SE PAGO[I] = FALSO ENTÃO
  ||||FOLHA_PENDENTE <- FOLHA_PENDENTE + SALARIO[I]
  ||FIM
  |FIM
  |ESCREVA "TOTAL PENDENTE: R$ ", FOLHA_PENDENTE
  |SE FOLHA_PENDENTE = 0 ENTÃO
  ||ESCREVA "TODOS OS FUNCIONÁRIOS JÁ FORAM PAGOS NESTE CICLO"
  |SENÃO
  ||ESCREVA "DESEJA QUITAR OS SALÁRIOS PENDENTES? S/N"
  ||LEIA CONFIRMACAO
  ||SE CONFIRMACAO = "S" ENTÃO
  ||INÍCIO
  |||SE SALDO_CAIXA >= FOLHA_PENDENTE ENTÃO
  ||||SALDO_CAIXA <- SALDO_CAIXA - FOLHA_PENDENTE
  ||||SALARIOS_PAGOS <- SALARIOS_PAGOS + FOLHA_PENDENTE
  ||||PARA I <- 1 ATÉ TOTAL_FUNCIONARIOS FAÇA
  |||||SE FUNCIONARIO[I] ESTIVER CADASTRADO ENTÃO
  ||||||PAGO[I] <- VERDADEIRO
  ||||FIM
  ||||ESCREVA "FOLHA SALARIAL QUITADA COM SUCESSO"
  |||SENÃO
  ||||ESCREVA "SALDO EM CAIXA INSUFICIENTE PARA PAGAR OS SALÁRIOS"
  |||FIM
  ||FIM
  |FIM
FIM
FIM_ALGORITMO

