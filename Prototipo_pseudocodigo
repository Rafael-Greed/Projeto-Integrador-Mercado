ALGORITMO LoginFuncionario()
DECLARE CPF_LOGIN, SENHA_LOGIN, ID_GERENTE, SENHA_GERENTE TEXTO
DECLARE FUNC_LOGADO, TENTATIVAS, I NUMÉRICO
DECLARE ACESSO_LIBERADO LÓGICO
INÍCIO
  |CPF_LOGIN <- LerCPFValido()
  |FUNC_LOGADO <- 0

  |PARA I <- 1 ATÉ TOTAL_FUNCIONARIOS FAÇA
  ||SE CPF_FUNCIONARIO[I] = CPF_LOGIN ENTÃO
  |||FUNC_LOGADO <- I

  |SE FUNC_LOGADO = 0 ENTÃO
  ||ESCREVA "CPF NÃO CADASTRADO"
  ||RETORNE

  |ESCREVA "USUÁRIO: ", ID_FUNCIONARIO[FUNC_LOGADO], " - ", NOME_FUNCIONARIO[FUNC_LOGADO]
  |TENTATIVAS <- 3
  |ACESSO_LIBERADO <- FALSO

  |ENQUANTO TENTATIVAS > 0 E ACESSO_LIBERADO = FALSO FAÇA
  |INÍCIO
  ||ESCREVA "DIGITE SUA SENHA: "
  ||LEIA SENHA_LOGIN
  ||SE SENHA_LOGIN = SENHA_FUNCIONARIO[FUNC_LOGADO] ENTÃO
  |||ACESSO_LIBERADO <- VERDADEIRO
  ||SENÃO
  |||TENTATIVAS <- TENTATIVAS - 1
  |||SE TENTATIVAS > 0 ENTÃO
  ||||ESCREVA "SENHA INCORRETA. Restam ", TENTATIVAS
  |||SENÃO
  ||||ESCREVA "BLOQUEIO DE SEGURANÇA"
  ||||ESCREVA "DIGITE ID DO GERENTE: "
  ||||LEIA ID_GERENTE
  ||||ESCREVA "SENHA DO GERENTE: "
  ||||LEIA SENHA_GERENTE
  ||||PARA I <- 1 ATÉ TOTAL_FUNCIONARIOS FAÇA
  |||||SE ID_FUNCIONARIO[I] = ID_GERENTE E CARGO[I] = "GERENTE" E SENHA_FUNCIONARIO[I] = SENHA_GERENTE ENTÃO
  ||||||ACESSO_LIBERADO <- VERDADEIRO
  ||||FIM
  |||FIM
  ||FIM
  |FIM

  |SE ACESSO_LIBERADO = VERDADEIRO ENTÃO
  ||MenuAdministrativo(FUNC_LOGADO)
FIM
