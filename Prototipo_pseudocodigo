ALGORITMO EmitirNotaFiscalSaida()
DECLARE I NUMÉRICO
DECLARE VALOR_ITEM, TOTAL_BRUTO, TOTAL_ICMS NUMÉRICO
DECLARE UF_DESTINO TEXTO
INÍCIO
  |ESCREVA "UF DESTINO [Exemplo: SP]: "
  |LEIA UF_DESTINO
  |TOTAL_BRUTO <- 0
  |TOTAL_ICMS <- 0

  |PARA I <- 1 ATÉ TOTAL_PRODUTOS FAÇA
  |INÍCIO
  ||SE PRODUTO[I] ESTIVER CADASTRADO ENTÃO
  ||INÍCIO
  |||VALOR_ITEM <- PRECO[I] * ESTOQUE[I]
  |||TOTAL_BRUTO <- TOTAL_BRUTO + VALOR_ITEM
  |||TOTAL_ICMS <- TOTAL_ICMS + CalcularImpostoItem(VALOR_ITEM, BuscarAliquotaICMS(NCM[I], "SP", UF_DESTINO, ANO_FISCAL))
  ||FIM
  |FIM

  |ESCREVA "NOTA FISCAL DE SAÍDA - EXERCÍCIO ", ANO_FISCAL
  |ESCREVA "VALOR BRUTO: R$ ", TOTAL_BRUTO
  |ESCREVA "TRIBUTOS ESTIMADOS: R$ ", TOTAL_ICMS
FIM
FIM_ALGORITMO

============================================================
MÓDULO 32 — BALANÇO FINANCEIRO E DRE
============================================================

ALGORITMO ExibirBalancoFinanceiro()
DECLARE LUCRO_BRUTO, LUCRO_OPERACIONAL, IMPOSTOS_LUCRO, LUCRO_LIQUIDO NUMÉRICO
INÍCIO
  |LUCRO_BRUTO <- RECEITA_VENDAS - GASTOS_ESTOQUE
  |LUCRO_OPERACIONAL <- LUCRO_BRUTO - SALARIOS_PAGOS

  |SE LUCRO_OPERACIONAL > 0 ENTÃO
  ||IMPOSTOS_LUCRO <- LUCRO_OPERACIONAL * 0.15
  |SENÃO
  ||IMPOSTOS_LUCRO <- 0

  |LUCRO_LIQUIDO <- LUCRO_OPERACIONAL - IMPOSTOS_LUCRO

  |ESCREVA "=================================================="
  |ESCREVA "      BALANÇO FINANCEIRO E DEMONSTRATIVO DRE"
  |ESCREVA "=================================================="
  |ESCREVA "SALDO ATUAL EM CAIXA: R$ ", SALDO_CAIXA
  |ESCREVA "RECEITA BRUTA DE VENDAS: R$ ", RECEITA_VENDAS
  |ESCREVA "CUSTOS DE ABASTECIMENTO/ESTOQUE: R$ ", GASTOS_ESTOQUE
  |ESCREVA "LUCRO BRUTO DA LOJA: R$ ", LUCRO_BRUTO
  |ESCREVA "CUSTOS DA FOLHA DE PAGAMENTO: R$ ", SALARIOS_PAGOS
  |ESCREVA "LUCRO OPERACIONAL ANTES DOS IMPOSTOS: R$ ", LUCRO_OPERACIONAL
  |ESCREVA "IMPOSTOS SOBRE O LUCRO (15%): R$ ", IMPOSTOS_LUCRO
  |ESCREVA "LUCRO LÍQUIDO FINAL DA LOJA: R$ ", LUCRO_LIQUIDO
FIM
FIM_ALGORITMO

