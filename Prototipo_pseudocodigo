ALGORITMO CadastrarFuncionario()
DECLARE NOME, CPF, CARGO, ID, SENHA TEXTO
DECLARE SALARIO, OPCAO_CARGO NUMÉRICO
INÍCIO
  |SE TOTAL_FUNCIONARIOS >= 10 ENTÃO
  ||ESCREVA "LIMITE DE FUNCIONÁRIOS ATINGIDO"
  ||RETORNE

  |ESCREVA "ID FUNCIONAL: "
  |LEIA ID
  |NOME <- LerNomeValido()
  |CPF <- LerCPFValido()
  |ESCREVA "CARGO (1-Gerente 2-Operador 3-Financeiro): "
  |LEIA OPCAO_CARGO

  |SE OPCAO_CARGO = 1 ENTÃO
  ||CARGO <- "GERENTE"
  |SENÃO SE OPCAO_CARGO = 3 ENTÃO
  ||CARGO <- "FINANCEIRO"
  |SENÃO
  ||CARGO <- "OPERADOR"

  |SALARIO <- ObterSalarioPadraoCargo(CARGO)
  |SENHA <- GerarSenhaAleatoria()

  |TOTAL_FUNCIONARIOS <- TOTAL_FUNCIONARIOS + 1
  |ID_FUNCIONARIO[TOTAL_FUNCIONARIOS] <- ID
  |NOME_FUNCIONARIO[TOTAL_FUNCIONARIOS] <- NOME
  |CPF_FUNCIONARIO[TOTAL_FUNCIONARIOS] <- CPF
  |CARGO[TOTAL_FUNCIONARIOS] <- CARGO
  |SENHA_FUNCIONARIO[TOTAL_FUNCIONARIOS] <- SENHA
  |SALARIO[TOTAL_FUNCIONARIOS] <- SALARIO
  |PAGO[TOTAL_FUNCIONARIOS] <- FALSO

  |ESCREVA "FUNCIONÁRIO CADASTRADO COM SUCESSO"
  |ESCREVA "SENHA: ", SENHA, " | SALÁRIO: R$ ", SALARIO
FIM
FIM_ALGORITMO

