ALGORITMO AjustarPrecoEDesconto()
DECLARE ID, TIPO NUMÉRICO
DECLARE NOVO_PRECO, DESCONTO NUMÉRICO
INÍCIO
  |ExibirCatalogo()
  |ESCREVA "ID DO PRODUTO: "
  |LEIA ID
  |SE ID NÃO EXISTIR ENTÃO
  ||ESCREVA "ID INEXISTENTE"
  ||RETORNE

  |ESCREVA "1 - Novo Preço   2 - Aplicar Desconto %"
  |LEIA TIPO

  |SE TIPO = 1 ENTÃO
  ||ESCREVA "NOVO PREÇO: "
  ||LEIA NOVO_PRECO
  ||SE NOVO_PRECO >= 0 ENTÃO
  |||PRECO[ID] <- NOVO_PRECO
  |||ESCREVA "PREÇO ATUALIZADO"
  ||SENÃO
  |||ESCREVA "PREÇO NÃO PODE SER NEGATIVO"
  |SENÃO SE TIPO = 2 ENTÃO
  ||ESCREVA "PERCENTUAL DE DESCONTO: "
  ||LEIA DESCONTO
  ||SE DESCONTO >= 0 E DESCONTO <= 100 ENTÃO
  |||PRECO[ID] <- PRECO[ID] * (1 - DESCONTO / 100)
  |||ESCREVA "DESCONTO APLICADO"
  ||SENÃO
  |||ESCREVA "PERCENTUAL INVÁLIDO"
  |SENÃO
  ||ESCREVA "OPÇÃO INVÁLIDA"
FIM
FIM_ALGORITMO

