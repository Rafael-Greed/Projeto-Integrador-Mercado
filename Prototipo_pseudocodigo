  ||ESCREVA "ID DE PRODUTO INEXISTENTE"
  ||RETORNE
  |ESCREVA "1 - DEFINIR NOVO PREÇO"
  |ESCREVA "2 - APLICAR DESCONTO EM PORCENTAGEM"
  |LEIA TIPO
  |SE TIPO = 1 ENTÃO
  ||ESCREVA "DIGITE O NOVO PREÇO"
  ||LEIA NOVO_PRECO
  ||SE NOVO_PRECO >= 0 ENTÃO
  |||PRECO[ID] <- NOVO_PRECO
  |||ESCREVA "PREÇO ATUALIZADO"
  ||SENÃO
  |||ESCREVA "O PREÇO NÃO PODE SER NEGATIVO"
  |SENÃO SE TIPO = 2 ENTÃO
  ||ESCREVA "DIGITE O PERCENTUAL DE DESCONTO ENTRE 0 E 100"
  ||LEIA DESCONTO
  ||SE DESCONTO >= 0 E DESCONTO <= 100 ENTÃO
  |||PRECO[ID] <- PRECO[ID] - (PRECO[ID] * DESCONTO / 100)
  |||ESCREVA "DESCONTO APLICADO"
  ||SENÃO
