============================================================
MÓDULO 13 — VALIDAÇÃO DE CPF (COM DÍGITOS VERIFICADORES)
============================================================

ALGORITMO LerCPFValido()
DECLARE CPF TEXTO
DECLARE SOMA1, SOMA2, DV1, DV2, I, NUM NUMÉRICO
INÍCIO
  |ENQUANTO VERDADEIRO FAÇA
  |INÍCIO
  ||ESCREVA "CPF (DIGITE APENAS OS 11 NÚMEROS) [Exemplo: 11144477735]: "
  ||LEIA CPF
  ||REMOVER CARACTERES QUE NÃO SEJAM NÚMEROS DE CPF

  ||SE COMPRIMENTO(CPF) <> 11 OU CPF FOR SEQUÊNCIA REPETIDA ENTÃO
  |||ESCREVA "ERRO: CPF INVÁLIDO! Deve conter 11 dígitos e não pode ser sequência repetida."
  |||CONTINUE
  ||FIM

  ||// Cálculo dos Dígitos Verificadores (Algoritmo da Receita Federal - Módulo 11)
  ||SOMA1 <- 0
  ||SOMA2 <- 0
  ||PARA I <- 1 ATÉ 9 FAÇA
  ||INÍCIO
  |||NUM <- VALOR NUMÉRICO DO DÍGITO I DE CPF
  |||SOMA1 <- SOMA1 + NUM * (11 - I)
  |||SOMA2 <- SOMA2 + NUM * (12 - I)
  ||FIM

  ||DV1 <- 11 - (SOMA1 MOD 11)
  ||SE DV1 > 9 ENTÃO
  |||DV1 <- 0
  ||FIM

  ||SOMA2 <- SOMA2 + DV1 * 2
  ||DV2 <- 11 - (SOMA2 MOD 11)
  ||SE DV2 > 9 ENTÃO
  |||DV2 <- 0
  ||FIM

  ||SE DV1 = DÍGITO 10 DE CPF E DV2 = DÍGITO 11 DE CPF ENTÃO
  |||INTERROMPA
  ||SENÃO
  |||ESCREVA "ERRO: Os dígitos verificadores do CPF não conferem matematicamente!"
  ||FIM
  |FIM
  |RETORNE CPF
FIM
FIM_ALGORITMO

